// clang-format off
DEFINE_UI_PARAMS(logc, LogC, DCTLUI_COMBO_BOX, 0, {LOGC3, LOGC4}, {LogC3, LogC4})
DEFINE_UI_PARAMS(ei, LogC3 EI, DCTLUI_COMBO_BOX, 7, {EI160, EI200, EI250, EI320, EI400, EI500, EI640, EI800, EI1000, EI1280, EI1600}, {EI 160, EI 200, EI 250, EI 320, EI 400, EI 500, EI 640, EI 800, EI 1000, EI 1280, EI 1600})
DEFINE_UI_PARAMS(cpoints, C points, DCTLUI_SLIDER_FLOAT, 25, 0, 50, 0.1) // Cyan   points (affects Red)
DEFINE_UI_PARAMS(mpoints, M points, DCTLUI_SLIDER_FLOAT, 25, 0, 50, 0.1) // Magenta points (affects Green)
DEFINE_UI_PARAMS(ypoints, Y points, DCTLUI_SLIDER_FLOAT, 25, 0, 50, 0.1) // Yellow  points (affects Blue)
DEFINE_UI_PARAMS(wpoints, W points, DCTLUI_SLIDER_FLOAT, 25, 0, 50, 0.1) // White (master) points
DEFINE_UI_PARAMS(rtrim, R trim, DCTLUI_SLIDER_FLOAT, 25, 0, 50, 0.1) // +R adds Red, -R cuts Red
DEFINE_UI_PARAMS(gtrim, G trim, DCTLUI_SLIDER_FLOAT, 25, 0, 50, 0.1) // +G adds Green, -G cuts Green
DEFINE_UI_PARAMS(btrim, B trim, DCTLUI_SLIDER_FLOAT, 25, 0, 50, 0.1) // +B adds Blue, -B cuts Blue
DEFINE_UI_PARAMS(mapprinterlights, Use printer points, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(maptrims, Use trims, DCTLUI_CHECK_BOX, 1)

// clang-format on
#include "PD-Common.h"
#include "PD-LogC.h"

__DEVICE__ inline float pointsgain(float points_delta)
{
    // 12 points = 1 stop
    const float points_per_stop = 12.0f;
    return exp2_f(points_delta / points_per_stop);
}

__DEVICE__ float3 printerpoints(float3 lin_rgb, float c, float m, float y, float w)
{
    // neutral is 25
    float dc = c - 25.0f;
    float dm = m - 25.0f;
    float dy = y - 25.0f;
    float dw = w - 25.0f;
    // white/master gain first (negative delta = cut)
    // For CMY: Cyan cuts Red, Magenta cuts Green, Yellow cuts Blue
    // So channel gains are master * cuts from complementary dyes
    float gw = pointsgain(-dw);
    float gr = gw * pointsgain(-dc);
    float gg = gw * pointsgain(-dm);
    float gb = gw * pointsgain(-dy);
    float3 out = make_float3(lin_rgb.x * gr, lin_rgb.y * gg, lin_rgb.z * gb);
    // avoid denorms / divide-by-zero
    const float eps = 1e-8f;
    out.x = max_f(out.x, eps);
    out.y = max_f(out.y, eps);
    out.z = max_f(out.z, eps);
    return out;
}

__DEVICE__ float3 rgbtrims(float3 linrgb, float r, float g, float b)
{
    float dr = r - 25.0f;
    float dg = g - 25.0f;
    float db = b - 25.0f;
    float gr = pointsgain(dr);
    float gg = pointsgain(dg);
    float gb = pointsgain(db);
    float3 out = make_float3(linrgb.x * gr, linrgb.y * gg, linrgb.z * gb);
    const float eps = 1e-8f;
    out.x = max_f(out.x, eps);
    out.y = max_f(out.y, eps);
    out.z = max_f(out.z, eps);
    return out;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = make_float3(p_R, p_G, p_B);
    if (logc == LOGC3) {
        rgb = logC3_lin(rgb, ei);
    } else {
        rgb = logC4_lin(rgb);
    }

    if (mapprinterlights) {
        rgb = printerpoints(rgb, cpoints, mpoints, ypoints, wpoints);
    }

    if (maptrims) {
        rgb = rgbtrims(rgb, rtrim, gtrim, btrim);
    }

    if (logc == LOGC3) {
        rgb = lin_logC3(rgb, ei);
    } else {
        rgb = lin_logC4(rgb);
    }
    return rgb;
}
