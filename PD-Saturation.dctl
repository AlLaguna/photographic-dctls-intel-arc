// PD-SaturationY
// Luma-axis saturation test with selectable color space coefficients.

// clang-format off
DEFINE_UI_PARAMS(saturation, Saturation, DCTLUI_SLIDER_FLOAT, 50, 0, 100, 1)
DEFINE_UI_PARAMS(lumaaxis, Luma axis, DCTLUI_COMBO_BOX, 6, {INXYZ, INACESAP0, INACESAP1, INAWGC3, INAWGC4, INDWG, INREC709, INSRGB, INDCIP3D60, INDCIP3, INDCIP3D65, INGEN5}, {CIE XYZ, AcesAP0 D60, AcesAP1 D60, ARRI AWG3 D65, ARRI AWG4 D65, DaVinci Wide Gamut D65, Rec709 D65, sRGB D65, DCI-P3 'D60 sim' D60, DCI-P3 Theatrical D63, DCI-P3 D65, Blackmagic Gen5 D65})
DEFINE_UI_PARAMS(inputgamma, Input gamma, DCTLUI_COMBO_BOX, 0, {INLIN, INACESCC, INACESCCT, INLOGC3, INLOGC4, INCINEON, INDWGINTERMEDIATE, INSRGBGAMMA22, INGAMMA24, INGAMMA26, INFILM5}, {Linear, AcesCC, AcesCCT, ARRI LogC3, ARRI LogC4, Cineon, DaVinci Intermediate, sRGB/Gamma2.2, Rec709/Gamma2.4, DCI-P3/Gamma2.6, Blackmagic Film})
DEFINE_UI_PARAMS(outputgamma, Output gamma, DCTLUI_COMBO_BOX, 0, {OUTLIN, OUTACESCC, OUTACESCCT, OUTLOGC3, OUTLOGC4, OUTCINEON, OUTDWGINTERMEDIATE, OUTSRGBGAMMA22, OUTGAMMA24, OUTGAMMA26, OUTFILM5}, {Linear, AcesCC, AcesCCT, ARRI LogC3, ARRI LogC4, Cineon, DaVinci Intermediate, sRGB/Gamma2.2, Rec709/Gamma2.4, DCI-P3/Gamma2.6, Blackmagic Film})
DEFINE_UI_PARAMS(ei, LogC3 EI, DCTLUI_COMBO_BOX, 7, {EI160, EI200, EI250, EI320, EI400, EI500, EI640, EI800, EI1000, EI1280, EI1600}, {EI 160, EI 200, EI 250, EI 320, EI 400, EI 500, EI 640, EI 800, EI 1000, EI 1280, EI 1600})
DEFINE_UI_PARAMS(adjustdisplay, Adjust for display, DCTLUI_CHECK_BOX, 0)

// clang-format on
#include "PD-Common.h"
#include "PD-Aces.h"
#include "PD-Cineon.h"
#include "PD-DWG.h"
#include "PD-DCIP3.h"
#include "PD-Gen5.h"
#include "PD-LogC.h"
#include "PD-Rec709.h"
#include "PD-sRGB.h"

struct SaturationYParams
{
    int lumaaxis;
    int inputgamma;
    int outputgamma;
    int ei;
};

__DEVICE__ float saturation_factor(float value)
{
    if (value <= 50.0f) {
        return value / 50.0f;
    }

    return 1.0f + (value - 50.0f) / 50.0f;
}

__DEVICE__ float3 input_gamma_to_linear(float3 rgb, struct SaturationYParams params)
{
    switch (params.inputgamma) {
        case INACESCC:
            rgb = acescc_lin(rgb);
            break;
        case INACESCCT:
            rgb = acescct_lin(rgb);
            break;
        case INLOGC3:
            rgb = logC3_lin(rgb, params.ei);
            break;
        case INLOGC4:
            rgb = logC4_lin(rgb);
            break;
        case INCINEON:
            rgb = cineon_lin(rgb);
            break;
        case INDWGINTERMEDIATE:
            rgb = dwgintermediate_lin(rgb);
            break;
        case INSRGBGAMMA22:
            rgb = sRGBgamma22_lin(rgb);
            break;
        case INGAMMA24:
            rgb = rec709gamma24_lin(rgb);
            break;
        case INGAMMA26:
            rgb = dcip3gamma26_lin(rgb);
            break;
        case INFILM5:
            rgb = gen5_lin(rgb);
            break;
    }

    return rgb;
}

__DEVICE__ float3 linear_to_output_gamma(float3 rgb, struct SaturationYParams params)
{
    switch (params.outputgamma) {
        case OUTACESCC:
            rgb = lin_acescc(rgb);
            break;
        case OUTACESCCT:
            rgb = lin_acescct(rgb);
            break;
        case OUTLOGC3:
            rgb = lin_logC3(rgb, params.ei);
            break;
        case OUTLOGC4:
            rgb = lin_logC4(rgb);
            break;
        case OUTCINEON:
            rgb = lin_cineon(rgb);
            break;
        case OUTDWGINTERMEDIATE:
            rgb = lin_dwgintermediate(rgb);
            break;
        case OUTSRGBGAMMA22:
            rgb = lin_sRGBgamma22(rgb);
            break;
        case OUTGAMMA24:
            rgb = lin_rec709gamma24(rgb);
            break;
        case OUTGAMMA26:
            rgb = lin_dcip3gamma26(rgb);
            break;
        case OUTFILM5:
            rgb = lin_gen5(rgb);
            break;
    }

    return rgb;
}

__DEVICE__ float3 luma_coefficients(struct SaturationYParams params)
{
    switch (params.lumaaxis) {
        case INACESAP0:
            return acesAP0_y_lum_coeff();
        case INACESAP1:
            return acesAP1_y_lum_coeff();
        case INAWGC3:
            return logc3_y_lum_coeff();
        case INAWGC4:
            return logc4_y_lum_coeff();
        case INDWG:
            return dwg_y_lum_coeff();
        case INREC709:
            return rec709_y_lum_coeff();
        case INSRGB:
            return sRGB_y_lum_coeff();
        case INDCIP3D60:
            return dcip3d60_y_lum_coeff();
        case INDCIP3:
            return dcip3_y_lum_coeff();
        case INDCIP3D65:
            return dcip3d65_y_lum_coeff();
        case INGEN5:
            return gen5_y_lum_coeff();
    }

    return rec709_y_lum_coeff();
}

__DEVICE__ float3 saturation_y(float3 rgb, float saturationValue, struct SaturationYParams params)
{
    float sat = saturation_factor(saturationValue);
    float3 coeff = luma_coefficients(params);

    float Y = rgb.x * coeff.x + rgb.y * coeff.y + rgb.z * coeff.z;

    return make_float3(
        Y + (rgb.x - Y) * sat,
        Y + (rgb.y - Y) * sat,
        Y + (rgb.z - Y) * sat);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = make_float3(p_R, p_G, p_B);

    struct SaturationYParams params;
    params.lumaaxis = lumaaxis;
    params.inputgamma = inputgamma;
    params.outputgamma = outputgamma;
    params.ei = ei;

    rgb = input_gamma_to_linear(rgb, params);
    rgb = saturation_y(rgb, saturation, params);
    rgb = linear_to_output_gamma(rgb, params);

    if (adjustdisplay) {
        rgb = adjust_display(rgb);
    }

    return rgb;
}